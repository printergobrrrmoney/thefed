# Public Enviornment Variables

# Set sensitive variables such as API keys in new files named
# .env.development, .env.test, or .env.production which will
# be ignored by git.

# Asset paths stay relative (see "homepage" in package.json) so the build
# works on any host. The canonical URL for social tags is set in index.html.

REACT_APP_TITLE=The Fed
REACT_APP_THEME_COLOR=FFFFFF
REACT_APP_DESCRIPTION=A simple game about central banking
REACT_APP_TAGLINE=A simple game about central banking

REACT_APP_UUID_V3_NAMESPACE=1895ccf1-ef92-4536-9890-3444c99099bc
